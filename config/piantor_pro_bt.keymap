#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/rgb.h>

#define NUM 1
#define SYM 2
#define EXTRA1 3
#define NUM_LOCK 4
#define NUM_MO 5

/ {
    chosen {
        zmk,physical-layout = &default_layout;
    };

    behaviors {
        hrm_ctrl: home_row_ctrl {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <160>;
            bindings = <&kp>, <&kp>;
        };

        hrm_alt: home_row_alt {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <160>;
            bindings = <&kp>, <&kp>;
        };

        hrm_gui: home_row_gui {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <160>;
            bindings = <&kp>, <&kp>;
        };
    };

    macros {
        cad_break: ctrl_alt_break {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_press &kp LCTRL &kp LALT>
                , <&macro_tap &kp PAUSE_BREAK>
                , <&macro_release &kp LALT &kp LCTRL>;
        };
    };
};

/ {
    // EXTRA 1 while NUMBER and SYMBOL are both on.
    // NUMBER itself is a then-layer so a lock flag can keep it on after Lower is released.
    conditional_layers {
        compatible = "zmk,conditional-layers";
        extra1_combo {
            if-layers = <NUM SYM>;
            then-layer = <EXTRA1>;
        };
        num_from_mo {
            if-layers = <NUM_MO>;
            then-layer = <NUM>;
        };
        num_from_lock {
            if-layers = <NUM_LOCK>;
            then-layer = <NUM>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "QWERTY";
            // --------------------------------------------------------------------------------
            // |  ESC |  Q  |  W  |  E  |  R  |  T  |  Y  |  U   |  I  |  O  |  P  |  \   |
            // |  TAB |  A  |ALT/S|GUI/D|  F  |  G  |  H  |  J   |GUI/K|ALT/L|  ;  |  '   |
            // | SHFT |  Z  |  X  |  C  |  V  |  B  |  N  |  M   |  ,  |  .  |CTL// | RSHFT|
            //                    | CTRL| LWR | BSPC| ENT | SPC  | RSE |
            bindings = <
                &kp ESC   &kp Q &kp W &kp E &kp R &kp T &kp Y &kp U  &kp I     &kp O   &kp P    &kp BSLH
                &kp TAB   &kp A &hrm_alt LALT S &hrm_gui LGUI D &kp F &kp G &kp H &kp J  &hrm_gui RGUI K     &hrm_alt RALT L   &kp SEMI &kp SQT
                &kp LSHFT &kp Z &kp X &kp C &kp V &kp B &kp N &kp M  &kp COMMA &kp DOT &hrm_ctrl RCTRL FSLH &kp RSHFT
                               &kp LCTRL &mo NUM_MO &kp BSPC &kp RET &kp SPACE &mo SYM
            >;
        };

        lower_layer {
            display-name = "NUMBER";
            // -----------------------------------------------------------------------------------------
            // |  TAB |  1  |  2  |  3  |  4  |  5    |  6  |  7  |  8  |  9  |  0  |  -   |
            // | CTRL | BT1 | BT2 | BT3 | BT4 | BT5   | LFT | DWN |  UP | RGT |     |      |
            // | SHFT | BTCR| RGB | RST | BOOT| Unlock|     |     |     |     |     | RCTRL|
            //                    |     | BASE| SPC   | GUI |     |     |
            bindings = <
                &kp TAB   &kp N1       &kp N2          &kp N3       &kp N4       &kp N5         &kp N6   &kp N7   &kp N8 &kp N9    &kp N0 &kp MINUS
                &kp LCTRL &bt BT_SEL 0 &bt BT_SEL 1    &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4   &kp LEFT &kp DOWN &kp UP &kp RIGHT &trans &trans
                &kp LSHFT &bt BT_CLR   &rgb_ug RGB_TOG &sys_reset   &bootloader  &studio_unlock &trans   &trans   &trans &trans   &trans   &kp RCTRL
                                                       &trans       &to 0        &kp SPACE      &kp LGUI &trans   &trans
            >;
        };

        raise_layer {
            display-name = "SYMBOL";
            // -----------------------------------------------------------------------------------------
            // |   =  |  !  |  @  |  #  |  $  |  %  |  ^  |  &  |  *  |  (  |  )  | BSPC |
            // | CTRL | HUD | HUI |     |     |     |  -  |  =  |  [  |  ]  |  \  |  `   |
            // | SHFT |     |     |     |     |     |  _  |  +  |  {  |  }  | "|" | RALT |
            //                    |     |     | DEL | ENT |     | ALT |
            bindings = <
                &kp EQUAL &kp EXCL        &kp AT          &kp HASH &kp DLLR &kp PRCNT &kp CARET &kp AMPS  &kp ASTRK &kp LPAR &kp RPAR &kp BSPC
                &kp LCTRL &rgb_ug RGB_HUD &rgb_ug RGB_HUI &trans   &trans   &trans    &kp MINUS &kp EQUAL &kp LBKT  &kp RBKT &kp BSLH &kp GRAVE
                &kp LSHFT &trans          &trans          &trans   &trans   &trans    &kp UNDER &kp PLUS  &kp LBRC  &kp RBRC &kp PIPE &kp RALT
                                                          &trans   &trans   &kp DEL   &kp RET   &trans   &kp RALT
            >;
        };

        extra_layer_1 {
            display-name = "EXTRA 1";
            // --------------------------------------------------------------------------------
            // |  F1  | F2  | F3  | F4  | F5  | F6  | F7  | F8  | F9  | F10 | F11 | F12  |
            // |      |     |     |     |NUMTG|     |     |     |     |C+A+Brk|     |      |
            // |      |     |     |     |     |     |     |     |     |     |     |      |
            //                    |     |     |     |     |     |     |
            bindings = <
                &kp F1 &kp F2 &kp F3 &kp F4 &kp F5 &kp F6  &kp F7 &kp F8 &kp F9 &kp F10 &kp F11 &kp F12
                &trans &trans &trans &trans &tog NUM_LOCK &trans  &trans &trans &trans &cad_break &trans  &trans
                &trans &trans &trans &trans &trans &trans  &trans &trans &trans &trans  &trans  &trans
                                     &trans &trans &trans  &trans &trans &trans
            >;
        };

        extra_layer_2 {
            display-name = "NUMBER";
            bindings = <
                &trans &trans &trans &trans &trans &trans  &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans  &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans  &trans &trans &trans &trans &trans &trans
                                     &trans &trans &trans  &trans &trans &trans       
            >;
        };

        extra_layer_3 {
            display-name = "NUMBER";
            bindings = <
                &trans &trans &trans &trans &trans &trans  &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans  &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans  &trans &trans &trans &trans &trans &trans
                                     &trans &trans &trans  &trans &trans &trans       
            >;
        };

        extra_layer_4 {
            display-name = "EXTRA 4";
            bindings = <
                &trans &trans &trans &trans &trans &trans  &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans  &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans  &trans &trans &trans &trans &trans &trans
                                     &trans &trans &trans  &trans &trans &trans       
            >;
        };

        extra_layer_5 {
            display-name = "EXTRA 5";
            bindings = <
                &trans &trans &trans &trans &trans &trans  &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans  &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans  &trans &trans &trans &trans &trans &trans
                                     &trans &trans &trans  &trans &trans &trans       
            >;
        };

        extra_layer_6 {
            display-name = "EXTRA 6";
            bindings = <
                &trans &trans &trans &trans &trans &trans  &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans  &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans  &trans &trans &trans &trans &trans &trans
                                     &trans &trans &trans  &trans &trans &trans       
            >;
        };
    };
};
